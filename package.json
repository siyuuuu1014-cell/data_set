{
  "name": "nuwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "setup": "node scripts/setup.js",
    "dev": "node scripts/setup.js && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:node": "node --import tsx --test tests/video-annotation/upload-stream.test.ts tests/video-annotation/model-result.test.ts tests/video-annotation/annotation-options.test.ts tests/video-annotation/remote-semantic-config.test.ts tests/video-annotation/video-delete.test.ts tests/video-annotation/frame-annotations.test.ts tests/video-annotation/manual-track.test.ts tests/video-annotation/annotation-migrations.test.ts tests/video-annotation/segment-split.test.ts tests/video-annotation/workflow-features.test.ts",
    "test:worker": "node scripts/run-worker-tests.mjs",
    "test": "npm run test:node && npm run test:worker && npm run typecheck"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "jszip": "^3.10.1",
    "next": "16.2.9",
    "parquetjs": "^0.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
