# Copy this file to worker.env. Shell variables take precedence over this file.
# Do not store HF_TOKEN here; provide it through your shell or secret manager.

# Runtime
NUWA_WORKER_PYTHON=
WORKER_HOST=127.0.0.1
WORKER_PORT=8765
# Set the same URL in the Next.js process when using a non-default address.
VIDEO_ANNOTATION_WORKER_URL=http://127.0.0.1:8765
NUWA_DEVICE=auto
NUWA_DEPLOYMENT_MODE=
VIDEO_ANNOTATION_DATA_ROOT=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Required only when the Next.js server reaches a non-loopback Worker.
NUWA_WORKER_ADMIN_TOKEN=

# Keep Hugging Face credentials and model caches on a persistent volume.
# Set this before authorizing or downloading so every Worker uses one cache.
HF_HOME=

# Model references and immutable revisions (commit hashes are recommended).
YOLO_MODEL=yolo11n
QWEN_LOCAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
QWEN_MODEL_REVISION=main
# This may also be an existing local snapshot directory. A local path prevents
# the Worker from downloading a second copy.
LOCATE_ANYTHING_MODEL=nvidia/LocateAnything-3B
LOCATE_ANYTHING_REVISION=main
# OCR uses the package-bundled RapidOCR ONNX detector and recognizer.
WHISPER_MODEL=openai/whisper-tiny
WHISPER_MODEL_REVISION=main
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_MODEL_REVISION=main

# Disable providers that are not installed. Defaults remain enabled for
# backward compatibility with the existing full annotation pipeline.
NUWA_PROVIDER_YOLO=true
NUWA_PROVIDER_TRACKER=true
NUWA_PROVIDER_LOCATE_ANYTHING=true
NUWA_PROVIDER_QWEN_VL=true
NUWA_PROVIDER_TROCR=true
NUWA_PROVIDER_WHISPER=true
NUWA_PROVIDER_DEPTH_ANYTHING=true
