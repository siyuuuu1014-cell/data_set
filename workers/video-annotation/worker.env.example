# Copy this file to worker.env. Shell variables take precedence over this file.
# Do not store HF_TOKEN here; provide it through your shell or secret manager.

# Runtime
NUWA_WORKER_PYTHON=
WORKER_HOST=127.0.0.1
WORKER_PORT=8765
# Set the same URL in the Next.js process when using a non-default address.
VIDEO_ANNOTATION_WORKER_URL=http://127.0.0.1:8765
NUWA_DEVICE=auto
NUWA_DEPLOYMENT_MODE=
VIDEO_ANNOTATION_DATA_ROOT=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional setup-only GPU wheel source. The values below match the validated
# Windows/Python 3.13/CUDA 13.2 environment; change them for other platforms.
NUWA_TORCH_INDEX_URL=
NUWA_TORCH_VERSION=2.13.0+cu132
NUWA_TORCHVISION_VERSION=0.28.0+cu132
# Required only when the Next.js server reaches a non-loopback Worker.
NUWA_WORKER_ADMIN_TOKEN=
# Optional override. Settings writes the default project-level file, so most
# deployments should leave this blank.
NUWA_VIDEO_SEMANTIC_CONFIG=

# Keep Hugging Face credentials and model caches on a persistent volume.
# Set this before authorizing or downloading so every Worker uses one cache.
HF_HOME=

# Model references and immutable revisions (commit hashes are recommended).
YOLO_MODEL=yolo11n
QWEN_LOCAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
QWEN_MODEL_REVISION=main
# This may also be an existing local snapshot directory. A local path prevents
# the Worker from downloading a second copy.
LOCATE_ANYTHING_MODEL=nvidia/LocateAnything-3B
LOCATE_ANYTHING_REVISION=main
# OCR uses the package-bundled RapidOCR ONNX detector and recognizer.
WHISPER_MODEL=openai/whisper-tiny
WHISPER_MODEL_REVISION=main
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_MODEL_REVISION=main

# Disable providers that are not installed. Defaults remain enabled for
# backward compatibility with the existing full annotation pipeline.
NUWA_PROVIDER_YOLO=true
NUWA_PROVIDER_TRACKER=true
NUWA_PROVIDER_LOCATE_ANYTHING=true
NUWA_PROVIDER_QWEN_VL=true
NUWA_PROVIDER_TROCR=true
NUWA_PROVIDER_WHISPER=true
NUWA_PROVIDER_DEPTH_ANYTHING=true

# LocateAnything keeps hybrid semantics by default. The 1024-pixel limit matches
# the model release's optimized runtime and prevents severe paging on 8GB GPUs.
LOCATE_MAX_SIDE=1024
LOCATE_MAX_NEW_TOKENS=512
# "fast" is optional but may reduce grounding quality in complex scenes.
LOCATE_GENERATION_MODE=hybrid
# Precision jobs use an evidence-driven bounded category list by default.
# Set "full" to restore the complete default category list for every precision job.
LOCATE_CATEGORY_MODE=adaptive
LOCATE_ADAPTIVE_MAX_CATEGORIES=18
LOCATE_ADAPTIVE_GENERATION_MODE=fast
LOCATE_ADAPTIVE_MAX_NEW_TOKENS=256

# Tracker backend: bytetrack (Kalman + two-stage association) or iou (legacy fallback).
NUWA_TRACKER_BACKEND=bytetrack
TRACK_LOW_THRESHOLD=0.1
TRACK_HIGH_THRESHOLD=0.65
TRACK_MATCH_THRESHOLD=0.8
TRACK_BUFFER=30
# Tracking uses more frames than semantic/OCR keyframes, but loads them in
# bounded batches to avoid increasing peak memory with long HD segments.
TRACKING_SAMPLE_FPS=3
TRACKING_FRAME_BATCH_SIZE=4

# Lightweight CPU person ReID (OpenCV Zoo YoutuReID ONNX, about 102 MiB).
# Disable to retain boundary-IoU-only identity stitching.
NUWA_PERSON_REID=true
PERSON_REID_MODEL_PATH=
PERSON_REID_MATCH_THRESHOLD=0.82
PERSON_REID_MAX_GAP_SECONDS=30
